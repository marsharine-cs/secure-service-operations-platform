# This file documents variable names only. Never commit real credentials.

# Application
NODE_ENV=development
WEB_PORT=5173
API_PORT=3000
AI_SERVICE_PORT=8000

# Data services
DATABASE_URL=postgresql://app:app@localhost:5432/service_operations
REDIS_URL=redis://localhost:6379
MONGODB_URL=mongodb://localhost:27017/service_operations_ai

# Authentication
JWT_ISSUER=service-operations-platform
JWT_AUDIENCE=service-operations-web
JWT_SECRET=replace-with-a-local-development-secret

# Internal service communication
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=replace-with-a-local-development-token

# Optional AI provider configuration
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=

# Observability
LOG_LEVEL=debug
OTEL_EXPORTER_OTLP_ENDPOINT=
